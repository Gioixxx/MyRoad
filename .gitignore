# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# launcher desktop (.NET) — vedi launcher/README.md e scripts/build-launcher.ps1
# dist/*.exe non è più committato: si rigenera con scripts/build-launcher.ps1 e si
# distribuisce solo via GitHub Release (vedi .claude/memory/decisions.md)
/launcher/MyRoadLauncher/wwwroot/
/launcher/MyRoadLauncher/bin/
/launcher/MyRoadLauncher/obj/
/launcher/MyRoadLauncher/publish/
/dist/*.exe
# profilo/cache WebView2 se mai creato accanto all'exe (non dovrebbe più succedere, vedi MainForm.cs)
/dist/*.WebView2/
# APK Android di release, firmata — si rigenera con scripts/build-android.ps1 e si distribuisce
# solo via GitHub Release, stesso principio di dist/*.exe (vedi .claude/memory/decisions.md)
/dist/*.apk

# claude-libs / progetto
ralph/run-state.json
.claude/memory-sync.log
.claude/memory/consolidation-report.md
.ralph-worktrees/
.claude/libs-ext/
